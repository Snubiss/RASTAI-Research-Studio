{
  "$defs": {
    "JobSummary": {
      "additionalProperties": false,
      "description": "One job: its run, node, kind and state.",
      "properties": {
        "error_code": {
          "description": "The catalog code it failed with; empty unless it failed.",
          "type": "string"
        },
        "job_id": {
          "description": "The job's id.",
          "type": "string"
        },
        "kind": {
          "description": "Its job kind, such as train.",
          "type": "string"
        },
        "node_id": {
          "description": "The node it runs on.",
          "type": "string"
        },
        "run_id": {
          "description": "The run it belongs to; empty for a job without a run.",
          "type": "string"
        },
        "state": {
          "description": "Its job state, such as running.",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "node_id",
        "kind",
        "state"
      ],
      "title": "JobSummary",
      "type": "object"
    },
    "arguments": {
      "additionalProperties": false,
      "description": "Which job to show.",
      "properties": {
        "job_id": {
          "description": "The job to show.",
          "type": "string",
          "x-rastai-cli-position": 0
        }
      },
      "required": [
        "job_id"
      ],
      "title": "JobGetArgs",
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "description": "One job.",
      "properties": {
        "job": {
          "$ref": "#/$defs/JobSummary",
          "description": "The job."
        }
      },
      "required": [
        "job"
      ],
      "title": "JobGetResult",
      "type": "object"
    }
  },
  "$id": "https://schemas.rastai.dev/commands/rastai.command.job.get/1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Show job",
  "title": "job.get",
  "x-rastai-kind": "sync",
  "x-rastai-since-version": "0.1.0",
  "x-rastai-stability": "preview"
}
