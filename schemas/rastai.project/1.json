{
  "$id": "https://schemas.rastai.dev/rastai.project/1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A project (project.json in a .rrsproj folder).",
  "properties": {
    "$schema": {
      "description": "URL of this document's JSON Schema.",
      "type": "string"
    },
    "authors": {
      "description": "Free-text author names.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "content_hash": {
      "description": "blake3:<64 hex> of the canonical content.",
      "type": "string"
    },
    "created_with": {
      "description": "rastai <app version> that wrote the file.",
      "type": "string"
    },
    "default_node": {
      "description": "local or a node id; empty means the compute.default_node setting.",
      "type": "string"
    },
    "derived_from": {
      "description": "<id>@<content_hash> of each parent (remix, import source).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "description": "Stable id, kept across edits.",
      "type": "string"
    },
    "license": {
      "description": "SPDX license id.",
      "type": "string"
    },
    "name": {
      "description": "The project's name.",
      "type": "string"
    },
    "requires": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Plugins the document needs: plugin id to semver range.",
      "type": "object"
    },
    "schema_version": {
      "description": "Version of the type's schema, from 1.",
      "type": "integer"
    },
    "source_url": {
      "description": "Where the document came from, if anywhere.",
      "type": "string"
    },
    "type": {
      "description": "Document type, e.g. rastai.model.",
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "type",
    "schema_version",
    "id",
    "name"
  ],
  "title": "Project",
  "type": "object"
}
