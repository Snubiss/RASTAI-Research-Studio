#!/usr/bin/env bash
# install-dev-tools: downloads the pinned dev tools a CI job needs, checks each download against its SHA-256 and
# puts the programs in ~/.local/bin, for the user only (no sudo). The CI workflows run it before their `just` recipe.
# It also works on a developer's machine, as a shortcut for the install steps in the justfile header.
#
# Usage: tools/ci/install-dev-tools <tool>...
#   tools: just, uv, node (with pnpm through corepack), cargo-deny, buf, protoc-gen-prost, protoc-gen-tonic,
#          browsers (the Chromium and WebKit builds Playwright runs @rastai/ui's browser tests in)
#
# protoc-gen-prost and protoc-gen-tonic have no prebuilt downloads, so they're built with `cargo install --locked`
# into ~/.cargo/bin, as the justfile header says; cargo checks each crate against the crates.io index's checksum.
# A build takes minutes, so a plugin already on PATH at its pinned version is kept: the `checks` job restores the
# built plugins from its cache before running this.
#
# cargo-fuzz isn't here: its prebuilt Linux download is a musl build, cargo-fuzz builds the fuzz targets for the
# platform it was built for, and the sanitizers don't work on musl. The nightly job uses `cargo install` instead.
#
# Playwright has no checksum file for its browser builds, so their SHA-256 values were taken from the first
# download when the pin was made (playwright 1.63.0, 2026-10-12); a later download that differs stops the install.
# Playwright never downloads them itself here: it finds them where it would have put them (PLAYWRIGHT_BROWSERS_DIR).
#
# The versions are the ones the repo pins elsewhere (the justfile, package.json, python/pyproject.toml);
# tests/workspace/ci-workflows.test.js fails if they drift apart. Each download is for the CI runners that use it:
# Linux x86_64, macOS arm64 and Windows x86_64 (Git Bash). Any other platform stops with a message, never a guess.

set -euo pipefail

INSTALL_DIR="$HOME/.local/bin"
# Node.js is a whole folder (bin/, lib/ and its bundled corepack): unpacked here, its programs linked into INSTALL_DIR.
NODE_PARENT_DIR="$HOME/.local/opt"

JUST_VERSION="1.58.0"
UV_VERSION="0.13.0"
NODE_VERSION="24.21.0"
CARGO_DENY_VERSION="0.20.2"
BUF_VERSION="1.73.0"
PROTOC_GEN_PROST_VERSION="0.5.0"
PROTOC_GEN_TONIC_VERSION="0.5.0"
# The browser builds playwright 1.63.0 (package.json devDependencies) launches, from its browsers.json: the
# headless Chromium shell and WebKit. Playwright looks for each in <browsers dir>/<name>-<revision>/.
PLAYWRIGHT_VERSION="1.63.0"
CHROMIUM_VERSION="153.0.8010.12"
CHROMIUM_HEADLESS_SHELL_REVISION="1243"
WEBKIT_REVISION="2359"
PLAYWRIGHT_BROWSERS_DIR="${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}"
PLAYWRIGHT_CDN="https://cdn.playwright.dev/builds"
# Playwright's WebKit links two Ubuntu libraries that a desktop install may lack (game controllers). Without sudo,
# `apt-get download` fetches them (apt checks each .deb against its signed index) and they are unpacked into the
# WebKit folders' own sys/lib, which their MiniBrowser wrappers and Playwright's host check both search.
WEBKIT_EXTRA_LIBRARY="libmanette-0.2.so.0"
WEBKIT_EXTRA_PACKAGES="libmanette-0.2-0 libhidapi-hidraw0"
WEBKIT_MINIBROWSER_FOLDERS="minibrowser-gtk minibrowser-wpe"

# The SHA-256 of each download, copied from the release's own checksum file when the pin was made. A download that
# differs (a replaced release asset, a tampered mirror) stops the install.
JUST_SHA256_LINUX="4a5cc2f53e6f0f8c59092a6cc38291eb729d46a7dd95d3ae582008881b84931d"
JUST_SHA256_MACOS="50ae3e996c974a0bf32ea7d10f495070df33f1b43e0616b2769e3d4821ed8f48"
JUST_SHA256_WINDOWS="759f16fb7aa17c5c8b9594b6d4a8c1a6630dfd042cf2b3ff84841454d3d188dc"
UV_SHA256_LINUX="1468ebd5a5541121837c5a2817b9972ba6090fa6caa3d142620850a47fb75154"
UV_SHA256_MACOS="a9c1b29002cf3c83f07fa9cd8a887a3be0107d90e23189721221e7257db8e3d6"
UV_SHA256_WINDOWS="088962f9e7b7bd9ea740c04c650b2a21c8928c345bd99ac24350dc924dba656c"
NODE_SHA256_LINUX="fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6"
NODE_SHA256_MACOS="6239d4cf92d864487ec8cd3615038f7b67e7f58b77b21cd2f09ea9fbd68065fe"
CARGO_DENY_SHA256_LINUX="9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f"
BUF_SHA256_LINUX="8f2986298ad08f0cc1bf999b9797b7c383adf32d7edf0f73d6f1e1a701baeac1"
CHROMIUM_HEADLESS_SHELL_SHA256_LINUX="a9da028861a0cf789ff25c2fed45f5f1aaf969ed9247835b6a7821a4f7af9d1d"
CHROMIUM_HEADLESS_SHELL_SHA256_MACOS="89d80a6d26ccd0ccfd51e22d9e1297283862af2b0cd91dce07459b35ca0059f2"
# Playwright builds WebKit per Ubuntu release: 24.04 is the CI runner, 26.04 a current developer machine.
WEBKIT_SHA256_UBUNTU_24_04="8c129d989a1c48d826ca11b45acbba919039de811623dc3819ccbd95b69eeb62"
WEBKIT_SHA256_UBUNTU_26_04="4d5cafd101bae4755c0aba879aa7de77e55193553d76609b4258fa8355c4db7f"
# The macOS build is per macOS release too: 15 is the CI runner (macos-15).
WEBKIT_SHA256_MACOS_15="33902c98fc0442f916eaa1e006af775f03c65c554eacba78e446581ba2f71ffd"

# Every tool this script knows, for the usage messages.
KNOWN_TOOLS="just, uv, node, cargo-deny, buf, protoc-gen-prost, protoc-gen-tonic, browsers"

main() {
    if [ "$#" -eq 0 ]; then
        fail "name at least one tool: $KNOWN_TOOLS"
    fi
    PLATFORM="$(detect_platform)"
    WORK_DIR="$(mktemp -d)"
    trap 'rm -rf "$WORK_DIR"' EXIT
    mkdir -p "$INSTALL_DIR"
    for tool in "$@"; do
        install_tool "$tool"
    done
    add_install_dir_to_github_path
}

install_tool() {
    case "$1" in
        just) install_just ;;
        uv) install_uv ;;
        node) install_node ;;
        cargo-deny) install_cargo_deny ;;
        buf) install_buf ;;
        protoc-gen-prost) install_with_cargo protoc-gen-prost "$PROTOC_GEN_PROST_VERSION" ;;
        protoc-gen-tonic) install_with_cargo protoc-gen-tonic "$PROTOC_GEN_TONIC_VERSION" ;;
        browsers) install_browsers ;;
        *) fail "unknown tool: $1 (tools: $KNOWN_TOOLS)" ;;
    esac
}

# Prints linux, macos or windows: the three CI runners, each with one pinned download per tool.
detect_platform() {
    local system machine
    system="$(uname -s)"
    machine="$(uname -m)"
    case "$system-$machine" in
        Linux-x86_64) echo "linux" ;;
        Darwin-arm64) echo "macos" ;;
        MINGW64_NT*-x86_64 | MSYS_NT*-x86_64) echo "windows" ;;
        *) fail "no pinned downloads for $system $machine" ;;
    esac
}

install_just() {
    local asset sha256
    case "$PLATFORM" in
        linux)
            asset="just-$JUST_VERSION-x86_64-unknown-linux-musl.tar.gz"
            sha256="$JUST_SHA256_LINUX"
            ;;
        macos)
            asset="just-$JUST_VERSION-aarch64-apple-darwin.tar.gz"
            sha256="$JUST_SHA256_MACOS"
            ;;
        windows)
            asset="just-$JUST_VERSION-x86_64-pc-windows-msvc.zip"
            sha256="$JUST_SHA256_WINDOWS"
            ;;
    esac
    local folder
    folder="$(download_and_unpack "https://github.com/casey/just/releases/download/$JUST_VERSION/$asset" "$sha256")"
    copy_program "$folder" just
    "$INSTALL_DIR/just" --version
}

install_uv() {
    # The Linux and macOS archives hold a folder named after the platform (`inner`); the Windows zip holds the
    # programs themselves.
    local asset sha256 inner
    case "$PLATFORM" in
        linux)
            asset="uv-x86_64-unknown-linux-gnu.tar.gz"
            sha256="$UV_SHA256_LINUX"
            inner="uv-x86_64-unknown-linux-gnu"
            ;;
        macos)
            asset="uv-aarch64-apple-darwin.tar.gz"
            sha256="$UV_SHA256_MACOS"
            inner="uv-aarch64-apple-darwin"
            ;;
        windows)
            asset="uv-x86_64-pc-windows-msvc.zip"
            sha256="$UV_SHA256_WINDOWS"
            inner="."
            ;;
    esac
    local folder
    folder="$(download_and_unpack "https://github.com/astral-sh/uv/releases/download/$UV_VERSION/$asset" "$sha256")"
    copy_program "$folder/$inner" uv
    copy_program "$folder/$inner" uvx
    "$INSTALL_DIR/uv" --version
}

# Only the Linux and macOS JavaScript jobs need Node.js (plan 8.7), so Windows has no pinned download.
install_node() {
    local node_name sha256
    case "$PLATFORM" in
        linux)
            node_name="node-v$NODE_VERSION-linux-x64"
            sha256="$NODE_SHA256_LINUX"
            ;;
        macos)
            node_name="node-v$NODE_VERSION-darwin-arm64"
            sha256="$NODE_SHA256_MACOS"
            ;;
        windows)
            fail "no pinned Node.js download for Windows: only the Linux and macOS jobs run JavaScript"
            ;;
    esac
    local folder
    folder="$(download_and_unpack "https://nodejs.org/dist/v$NODE_VERSION/$node_name.tar.xz" "$sha256")"
    mkdir -p "$NODE_PARENT_DIR"
    rm -rf "${NODE_PARENT_DIR:?}/$node_name"
    mv "$folder/$node_name" "$NODE_PARENT_DIR/"
    for program in node npm corepack; do
        ln -sf "$NODE_PARENT_DIR/$node_name/bin/$program" "$INSTALL_DIR/$program"
    done
    "$INSTALL_DIR/node" --version
    # pnpm comes through corepack, which downloads the version package.json `packageManager` pins and refuses a
    # download whose sha512 differs.
    "$INSTALL_DIR/corepack" enable --install-directory "$INSTALL_DIR" pnpm
}

# cargo-deny runs only in the Linux `checks` job.
install_cargo_deny() {
    require_linux cargo-deny
    local name="cargo-deny-$CARGO_DENY_VERSION-x86_64-unknown-linux-musl"
    local release_url="https://github.com/EmbarkStudios/cargo-deny/releases/download/$CARGO_DENY_VERSION"
    local folder
    folder="$(download_and_unpack "$release_url/$name.tar.gz" "$CARGO_DENY_SHA256_LINUX")"
    copy_program "$folder/$name" cargo-deny
    "$INSTALL_DIR/cargo-deny" --version
}

# buf runs only in the Linux `checks` job (codegen-check and proto-check). Its release asset is the program itself,
# not an archive.
install_buf() {
    require_linux buf
    local url="https://github.com/bufbuild/buf/releases/download/v$BUF_VERSION/buf-Linux-x86_64"
    local file
    file="$(download_and_check "$url" "$BUF_SHA256_LINUX")"
    cp "$file" "$INSTALL_DIR/buf"
    chmod 755 "$INSTALL_DIR/buf"
    "$INSTALL_DIR/buf" --version
}

# The JavaScript jobs run the browser tests in Chromium and WebKit: Linux (`checks`, `test-js`) and macOS
# (`test-js-macos`). Each build is unpacked where Playwright looks for it, replacing an earlier copy of the same
# revision. The macOS pins are checked by the first manual CI run on macOS (PROC-01).
install_browsers() {
    case "$PLATFORM" in
        linux) install_browsers_linux ;;
        macos) install_browsers_macos ;;
        windows) fail "no pinned browser builds for Windows: only the Linux and macOS jobs run JavaScript" ;;
    esac
    echo "Chromium $CHROMIUM_VERSION and WebKit r$WEBKIT_REVISION for playwright $PLAYWRIGHT_VERSION are in" \
        "$PLAYWRIGHT_BROWSERS_DIR" >&2
}

install_browsers_linux() {
    local chromium_url="$PLAYWRIGHT_CDN/cft/$CHROMIUM_VERSION/linux64/chrome-headless-shell-linux64.zip"
    install_browser "$chromium_url" "$CHROMIUM_HEADLESS_SHELL_SHA256_LINUX" \
        "chromium_headless_shell-$CHROMIUM_HEADLESS_SHELL_REVISION"
    local ubuntu_release webkit_sha256
    ubuntu_release="$(ubuntu_release)"
    case "$ubuntu_release" in
        24.04) webkit_sha256="$WEBKIT_SHA256_UBUNTU_24_04" ;;
        26.04) webkit_sha256="$WEBKIT_SHA256_UBUNTU_26_04" ;;
        *) fail "no pinned WebKit build for Ubuntu '$ubuntu_release' (pinned: 24.04, 26.04)" ;;
    esac
    local webkit_url="$PLAYWRIGHT_CDN/webkit/$WEBKIT_REVISION/webkit-ubuntu-$ubuntu_release.zip"
    install_browser "$webkit_url" "$webkit_sha256" "webkit-$WEBKIT_REVISION"
    add_webkit_libraries "$PLAYWRIGHT_BROWSERS_DIR/webkit-$WEBKIT_REVISION"
}

install_browsers_macos() {
    local macos_major
    macos_major="$(sw_vers -productVersion | cut -d. -f1)"
    if [ "$macos_major" != "15" ]; then
        fail "no pinned WebKit build for macOS $macos_major (pinned: 15)"
    fi
    local chromium_url="$PLAYWRIGHT_CDN/cft/$CHROMIUM_VERSION/mac-arm64/chrome-headless-shell-mac-arm64.zip"
    install_browser "$chromium_url" "$CHROMIUM_HEADLESS_SHELL_SHA256_MACOS" \
        "chromium_headless_shell-$CHROMIUM_HEADLESS_SHELL_REVISION"
    local webkit_url="$PLAYWRIGHT_CDN/webkit/$WEBKIT_REVISION/webkit-mac-15-arm64.zip"
    install_browser "$webkit_url" "$WEBKIT_SHA256_MACOS_15" "webkit-$WEBKIT_REVISION"
}

install_browser() {
    local url="$1" sha256="$2" folder_name="$3"
    local folder
    folder="$(download_and_unpack "$url" "$sha256")"
    mkdir -p "$PLAYWRIGHT_BROWSERS_DIR"
    rm -rf "${PLAYWRIGHT_BROWSERS_DIR:?}/$folder_name"
    mv "$folder" "$PLAYWRIGHT_BROWSERS_DIR/$folder_name"
}

# Nothing to do when the system already has the library (a CI runner after `playwright install-deps`).
add_webkit_libraries() {
    local webkit_dir="$1"
    if ldconfig -p | grep -q "$WEBKIT_EXTRA_LIBRARY"; then
        return
    fi
    local package_dir="$WORK_DIR/webkit-libraries"
    mkdir -p "$package_dir"
    for package in $WEBKIT_EXTRA_PACKAGES; do
        (cd "$package_dir" && apt-get download "$package")
    done
    for package_file in "$package_dir"/*.deb; do
        dpkg-deb -x "$package_file" "$package_dir/unpacked"
    done
    for folder in $WEBKIT_MINIBROWSER_FOLDERS; do
        mkdir -p "$webkit_dir/$folder/sys/lib"
        cp -P "$package_dir"/unpacked/usr/lib/x86_64-linux-gnu/*.so.* "$webkit_dir/$folder/sys/lib/"
    done
    echo "Added $WEBKIT_EXTRA_PACKAGES to WebKit's own sys/lib" >&2
}

# The VERSION_ID of /etc/os-release on Ubuntu ("24.04"), or nothing on another distribution.
ubuntu_release() {
    if [ -r /etc/os-release ] && grep -q '^ID=ubuntu$' /etc/os-release; then
        sed -n 's/^VERSION_ID="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release
    fi
}

# Builds a crate's program into ~/.cargo/bin, unless the program found on PATH already prints the pinned version
# (a cached build, or an earlier install on a developer's machine).
install_with_cargo() {
    local name="$1" version="$2"
    local installed_version
    installed_version="$("$name" --version 2>/dev/null || true)"
    if [ "$installed_version" = "$version" ]; then
        echo "$name $version is already installed" >&2
        return
    fi
    cargo install --locked "$name@$version"
    "$name" --version
}

require_linux() {
    if [ "$PLATFORM" != "linux" ]; then
        fail "$1 has a pinned download for Linux only"
    fi
}

# Downloads a file into WORK_DIR, stops unless its SHA-256 is the pinned one, and prints the file's path.
download_and_check() {
    local url="$1" expected_sha256="$2"
    local file="$WORK_DIR/${url##*/}"
    echo "Downloading $url" >&2
    curl --fail --silent --show-error --location --retry 3 --output "$file" "$url"
    check_sha256 "$file" "$expected_sha256"
    echo "$file"
}

# Downloads a release archive, checks its SHA-256, unpacks it into a fresh folder and prints that folder.
download_and_unpack() {
    local url="$1" expected_sha256="$2"
    local file
    file="$(download_and_check "$url" "$expected_sha256")"
    local folder="$file.unpacked"
    mkdir -p "$folder"
    case "$file" in
        *.tar.gz) tar -xzf "$file" -C "$folder" ;;
        *.tar.xz) tar -xJf "$file" -C "$folder" ;;
        *.zip) unzip -q "$file" -d "$folder" ;;
        *) fail "don't know how to unpack $file" ;;
    esac
    echo "$folder"
}

check_sha256() {
    local file="$1" expected_sha256="$2"
    local actual_sha256
    actual_sha256="$(file_sha256 "$file")"
    if [ "$actual_sha256" != "$expected_sha256" ]; then
        fail "checksum mismatch for ${file##*/}: expected $expected_sha256, got $actual_sha256"
    fi
}

# Linux and Git Bash have sha256sum; macOS has shasum. Both print "<hash>  <file>".
file_sha256() {
    local output
    if command -v sha256sum > /dev/null; then
        output="$(sha256sum "$1")"
    else
        output="$(shasum -a 256 "$1")"
    fi
    echo "${output%% *}"
}

# Copies one program into INSTALL_DIR: <name> on Linux and macOS, <name>.exe on Windows.
copy_program() {
    local folder="$1" name="$2"
    if [ "$PLATFORM" = "windows" ]; then
        name="$name.exe"
    fi
    cp "$folder/$name" "$INSTALL_DIR/$name"
    chmod 755 "$INSTALL_DIR/$name"
}

# On a GitHub runner, later steps find the tools through $GITHUB_PATH, which takes a native path (C:\... on Windows).
add_install_dir_to_github_path() {
    if [ -z "${GITHUB_PATH:-}" ]; then
        return
    fi
    if [ "$PLATFORM" = "windows" ]; then
        cygpath --windows "$INSTALL_DIR" >> "$GITHUB_PATH"
    else
        echo "$INSTALL_DIR" >> "$GITHUB_PATH"
    fi
}

fail() {
    echo "install-dev-tools: $1" >&2
    exit 1
}

main "$@"
