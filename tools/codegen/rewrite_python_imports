#!/usr/bin/env python3
"""rewrite_python_imports: buf's Python plugin for python/rastai_proto (layout rust-node-gateway-proto.md 3.4).

protoc names Python modules after the proto package, so `rastai.common.v1` becomes `from rastai.common.v1 import
...`. That would collide with the public `rastai` SDK package. This plugin runs grpcio's generators (the protobuf
messages and the gRPC stubs, from grpcio-tools), then moves every file from rastai/<package>/v1/ to
<package>/v1/ under rastai_proto/ and rewrites the `rastai.` imports to `rastai_proto.`, so the generated code is
`rastai_proto.common.v1` and never shadows the SDK.

buf runs it as a protoc plugin (buf.gen.yaml, strategy `all`): it reads one CodeGeneratorRequest from stdin and
writes one CodeGeneratorResponse to stdout. Only import lines and the module name the generated code registers
change; the serialized descriptors keep the proto package `rastai.common.v1`, which is the wire name.
"""

import sys
import tempfile
from pathlib import Path

from google.protobuf import descriptor_pb2
from google.protobuf.compiler import plugin_pb2
from grpc_tools import protoc

# The proto package root every Rastai file sits under, and the Python package the generated code lives in.
PROTO_ROOT_FOLDER = "rastai/"
PROTO_ROOT_MODULE = "rastai."
PYTHON_PACKAGE_MODULE = "rastai_proto."
# The only lines that name a generated module: imports between generated files, and the call that sets each
# message class's __module__. Every other line (descriptor bytes, error text) is left exactly as generated.
IMPORT_PREFIX = "from rastai."
MODULE_NAME_CALL_PREFIX = "_builder.BuildTopDescriptorsAndMessages(DESCRIPTOR, 'rastai."
# Every folder of the generated package gets one, so it imports as a regular package.
INIT_FILE_NAME = "__init__.py"
INIT_FILE_TEXT = "# Generated by tools/codegen/rewrite_python_imports. Do not edit.\n"
# What the generated code relies on: `optional` fields (ResourceRequest.may_reclaim_evictable).
SUPPORTED_FEATURES = plugin_pb2.CodeGeneratorResponse.FEATURE_PROTO3_OPTIONAL


def main() -> int:
    request = plugin_pb2.CodeGeneratorRequest.FromString(sys.stdin.buffer.read())
    response = build_response(request)
    sys.stdout.buffer.write(response.SerializeToString())
    return 0


def build_response(request: plugin_pb2.CodeGeneratorRequest) -> plugin_pb2.CodeGeneratorResponse:
    response = plugin_pb2.CodeGeneratorResponse(supported_features=SUPPORTED_FEATURES)
    try:
        generated = run_grpcio_generators(request)
        rewritten = rewrite_files(generated)
    except ValueError as error:
        # A protoc plugin reports a problem in the response; buf prints it and fails the run.
        response.error = str(error)
        return response
    for name, text in sorted(rewritten.items()):
        response.file.add(name=name, content=text)
    return response


def run_grpcio_generators(request: plugin_pb2.CodeGeneratorRequest) -> dict[str, str]:
    """{path: text} of what grpcio-tools writes for the requested files: <name>_pb2.py and <name>_pb2_grpc.py.

    grpcio-tools is a protoc, not a plugin, so it gets the descriptors buf already compiled (the request holds
    every requested file and its imports) as a descriptor set file, and writes into a temporary folder.
    """
    with tempfile.TemporaryDirectory(prefix="rastai-python-codegen-") as temporary_folder:
        folder = Path(temporary_folder)
        descriptor_set_path = folder / "descriptors.binpb"
        output_folder = folder / "out"
        output_folder.mkdir()
        descriptor_set = descriptor_pb2.FileDescriptorSet(file=request.proto_file)
        descriptor_set_path.write_bytes(descriptor_set.SerializeToString())
        arguments = [
            "grpc_tools.protoc",
            f"--descriptor_set_in={descriptor_set_path}",
            f"--python_out={output_folder}",
            f"--grpc_python_out={output_folder}",
            *request.file_to_generate,
        ]
        exit_code = protoc.main(arguments)
        if exit_code != 0:
            raise ValueError(f"grpcio-tools failed with exit code {exit_code}; its errors are printed above")
        return read_folder(output_folder)


def read_folder(folder: Path) -> dict[str, str]:
    return {path.relative_to(folder).as_posix(): path.read_text() for path in folder.rglob("*") if path.is_file()}


def rewrite_files(generated: dict[str, str]) -> dict[str, str]:
    """The files as they go into rastai_proto/: moved out of rastai/, imports rewritten, plus an __init__.py in
    every folder."""
    rewritten = {}
    for name, text in generated.items():
        rewritten[package_path(name)] = rewrite_imports(text)
    for folder in package_folders(rewritten):
        rewritten[folder + INIT_FILE_NAME] = INIT_FILE_TEXT
    return rewritten


def package_path(generated_name: str) -> str:
    """rastai/common/v1/diagnostic_pb2.py -> common/v1/diagnostic_pb2.py (buf's out folder is rastai_proto/)."""
    if not generated_name.startswith(PROTO_ROOT_FOLDER):
        raise ValueError(f"{generated_name}: not under {PROTO_ROOT_FOLDER}; every Rastai proto package is rastai.*")
    return generated_name[len(PROTO_ROOT_FOLDER) :]


def rewrite_imports(text: str) -> str:
    lines = text.splitlines(keepends=True)
    return "".join(rewrite_line(line) for line in lines)


def rewrite_line(line: str) -> str:
    """`from rastai.common.v1 import x_pb2 as ...` -> `from rastai_proto.common.v1 import x_pb2 as ...`, and the
    same for the module name the generated code registers. The alias after `as` (rastai_dot_common_dot_...) has no
    dot after `rastai`, so replacing the first `rastai.` touches only the module path."""
    if line.startswith(IMPORT_PREFIX) or line.startswith(MODULE_NAME_CALL_PREFIX):
        return line.replace(PROTO_ROOT_MODULE, PYTHON_PACKAGE_MODULE, 1)
    return line


def package_folders(file_names: dict[str, str]) -> list[str]:
    """Every folder that holds a generated file, and each of their parents, as "" (the package root) or
    "common/", "common/v1/" and so on."""
    folders = set()
    for name in file_names:
        parts = name.split("/")[:-1]
        for depth in range(len(parts) + 1):
            folders.add("".join(part + "/" for part in parts[:depth]))
    return sorted(folders)


if __name__ == "__main__":
    sys.exit(main())
