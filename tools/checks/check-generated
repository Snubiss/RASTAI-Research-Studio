#!/usr/bin/env python3
"""check-generated: checked-in generated code equals a fresh codegen run (contracts 2.4 rule 2, `just codegen-check`).

Generated folders are never edited by hand and aren't reviewed, so CI proves them instead: every generator
writes into a temporary tree and each of its outputs, a folder or a single file, must match the checked-in one byte
for byte. Each codegen task adds its row to GENERATORS: buf for proto/ (M1-08), then the rastai-codegen binaries
(the catalog in M1-12, the formats in M1-16, the names registry in M1-57).

One generator's folder may hold another's file (schemas/ is the formats generator's, schemas/names.json the names
generator's). Such a file is compared only as the output of the generator that names it, so each mismatch is reported
once, against the generator that writes it.
"""

import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

from repo_files import SKIPPED_FOLDER_NAMES, parse_root_argument, report

# Replaced in a generator's command by the temporary folder it must write into, laid out like the repository.
OUTPUT_ROOT_PLACEHOLDER = "{output_root}"
# How much of a failing generator's error output to show.
ERROR_OUTPUT_LINES = 20


@dataclass(frozen=True)
class Generator:
    """One codegen step: the command (run from the repository root) and the outputs it owns, relative to the
    repository root. The command writes those outputs under OUTPUT_ROOT_PLACEHOLDER instead of in place.

    An output is a folder the generator owns whole, or a single file in a folder that also holds other things
    (generated.py beside a hand-written __init__.py, errors.md beside the other reference pages).

    failure_hint, when set, is printed after the generator's own error lines when it fails: where to look when the
    usual fix (run `just codegen`) can't work because the generator itself no longer builds."""

    name: str
    command: list[str]
    outputs: list[str]
    failure_hint: str = ""


# The codegen steps of `just codegen`, in its order (layout rust-control-plane.md 2.5). buf's --output puts every
# `out` folder of buf.gen.yaml under the temporary tree; its plugins run from the repository root as usual.
GENERATORS: list[Generator] = [
    Generator(
        name="buf generate (proto/, buf.gen.yaml)",
        command=["buf", "generate", "--output", OUTPUT_ROOT_PLACEHOLDER],
        outputs=[
            "crates/rastai-proto/src/generated",
            "python/rastai_proto/rastai_proto",
            "packages/proto/src/generated",
        ],
    ),
    # --locked: Cargo.lock is checked in and never silently changes. --quiet keeps cargo's build lines out of the
    # report; the generator's own errors still reach it.
    Generator(
        name="rastai-catalog-codegen (catalog/)",
        command=[
            "cargo",
            "run",
            "--quiet",
            "--locked",
            "-p",
            "rastai-codegen",
            "--bin",
            "rastai-catalog-codegen",
            "--",
            "--output",
            OUTPUT_ROOT_PLACEHOLDER,
        ],
        outputs=[
            "crates/rastai-diag/src/generated",
            "packages/catalog/src/generated",
            "python/rastai_plugin/rastai_plugin/catalog/generated.py",
            "docs/reference/errors.md",
        ],
        # rastai-codegen builds on rastai-diag, so a broken generated table breaks the generator too.
        failure_hint=(
            "if a generated table in crates/rastai-diag no longer compiles, crates/rastai-diag/CLAUDE.md "
            "says how to recover"
        ),
    ),
    # schemas/ but its names.json, which the names generator below writes.
    Generator(
        name="rastai-formats-codegen (type descriptions and commands)",
        command=[
            "cargo",
            "run",
            "--quiet",
            "--locked",
            "-p",
            "rastai-codegen",
            "--bin",
            "rastai-formats-codegen",
            "--",
            "--output",
            OUTPUT_ROOT_PLACEHOLDER,
        ],
        outputs=[
            "schemas",
            "packages/formats/src/generated",
            "packages/client/src/generated/commands.js",
            "python/rastai_formats/rastai_formats/generated",
            "docs/reference/commands.md",
        ],
    ),
    # Last, as in `just codegen`: it reads the catalog, the migrations and the descriptions (contracts 12.6).
    Generator(
        name="rastai-names-codegen (schemas/names.json)",
        command=[
            "cargo",
            "run",
            "--quiet",
            "--locked",
            "-p",
            "rastai-codegen",
            "--bin",
            "rastai-names-codegen",
            "--",
            "--output",
            OUTPUT_ROOT_PLACEHOLDER,
        ],
        outputs=["schemas/names.json"],
    ),
]


def main() -> int:
    root = parse_root_argument("Regenerates every generated output into a temporary tree and fails on any change.")
    problems = find_stale_files(root, GENERATORS)
    return report("check-generated", problems, "every generated output matches a fresh codegen run")


def find_stale_files(root: Path, generators: list[Generator]) -> list[str]:
    every_output = [output for generator in generators for output in generator.outputs]
    problems = []
    with tempfile.TemporaryDirectory(prefix="rastai-check-generated-") as temporary_folder:
        output_root = Path(temporary_folder)
        for generator in generators:
            generator_problems = run_generator(root, generator, output_root)
            if generator_problems:
                # A generator that failed wrote nothing (or only part of its outputs), so comparing would call every
                # checked-in output stale and say "delete it". Its own error lines are the whole report.
                problems.extend(generator_problems)
                continue
            for output in generator.outputs:
                problems.extend(compare_output(root, output_root, output, outputs_inside(output, every_output)))
    return problems


def outputs_inside(folder: str, every_output: list[str]) -> set[str]:
    """The outputs that sit inside folder (another generator's file in it), relative to folder."""
    prefix = f"{folder}/"
    return {output[len(prefix) :] for output in every_output if output.startswith(prefix)}


def run_generator(root: Path, generator: Generator, output_root: Path) -> list[str]:
    command = [part.replace(OUTPUT_ROOT_PLACEHOLDER, str(output_root)) for part in generator.command]
    try:
        result = subprocess.run(command, cwd=root, capture_output=True, text=True)
    except FileNotFoundError:
        return [f"{generator.name}: `{command[0]}` isn't installed; the justfile header says how to install it"]
    if result.returncode == 0:
        return []
    error_lines = result.stderr.strip().splitlines()[-ERROR_OUTPUT_LINES:]
    problems = [f"{generator.name} failed (exit {result.returncode}):"] + error_lines
    if generator.failure_hint:
        problems.append(f"{generator.name}: {generator.failure_hint}")
    return problems


def compare_output(root: Path, output_root: Path, output: str, owned_elsewhere: set[str]) -> list[str]:
    """Problems for one output: a single file when either side has a file there, otherwise a folder, leaving out the
    files in it that another generator owns."""
    if (root / output).is_file() or (output_root / output).is_file():
        return compare_file(root, output_root, output)
    return compare_folders(root, output_root, output, owned_elsewhere)


def compare_file(root: Path, output_root: Path, path: str) -> list[str]:
    checked_in = root / path
    regenerated = output_root / path
    if not checked_in.is_file():
        return [f"{path}: missing; run `just codegen` and commit the result"]
    if not regenerated.is_file():
        return [f"{path}: codegen no longer writes it; delete it"]
    if checked_in.read_bytes() != regenerated.read_bytes():
        return [f"{path}: differs from a fresh codegen run; never edit it, run `just codegen`"]
    return []


def compare_folders(root: Path, output_root: Path, folder: str, owned_elsewhere: set[str]) -> list[str]:
    """Problems for one output folder: files codegen writes that aren't checked in, checked-in files it no longer
    writes, and files whose bytes differ. Files another generator owns (owned_elsewhere) are its to compare."""
    checked_in = files_in(root / folder) - owned_elsewhere
    regenerated = files_in(output_root / folder) - owned_elsewhere
    problems = []
    for name in sorted(regenerated - checked_in):
        problems.append(f"{folder}/{name}: missing; run `just codegen` and commit the result")
    for name in sorted(checked_in - regenerated):
        problems.append(f"{folder}/{name}: codegen no longer writes it; delete it")
    for name in sorted(checked_in & regenerated):
        if (root / folder / name).read_bytes() != (output_root / folder / name).read_bytes():
            problems.append(f"{folder}/{name}: differs from a fresh codegen run; never edit it, run `just codegen`")
    return problems


def files_in(folder: Path) -> set[str]:
    """Every file below folder, as relative paths with / separators. A folder that doesn't exist holds none.
    Folders git ignores (SKIPPED_FOLDER_NAMES) are left out: importing the generated Python writes __pycache__/
    beside it, and that is no codegen output."""
    if not folder.is_dir():
        return set()
    files = set()
    for path in folder.rglob("*"):
        relative = path.relative_to(folder)
        if path.is_file() and not is_in_skipped_folder(relative):
            files.add(relative.as_posix())
    return files


def is_in_skipped_folder(relative: Path) -> bool:
    for part in relative.parts:
        if part in SKIPPED_FOLDER_NAMES:
            return True
    return False


if __name__ == "__main__":
    sys.exit(main())
