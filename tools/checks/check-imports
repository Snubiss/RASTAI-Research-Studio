# ---- Python ----


def check_python(root: Path) -> list[str]:
    problems = []
    for path in list_files(root, (".py",)):
        package, module_path = python_package_of(path)
        if package is None:
            continue
        if package not in PYTHON_INTERNAL_DEPS:
            problems.append(f"{path}: package `{package}` isn't in contracts 2.2 or check-imports' table")
            continue
        problems.extend(check_python_file(root, path, package, module_path))
    return problems


def python_package_of(path: str) -> tuple[str | None, str]:
    """(package, module path) of a file inside a package folder, else (None, ""). The package folder is named
    after its package, so python/rastai_data/rastai_data/image_decode.py gives
    ("rastai_data", "rastai_data/image_decode.py")."""
    for package_root in PYTHON_PACKAGE_ROOTS:
        root_depth = package_root.count("/")
        parts = path.split("/")
        if len(parts) > root_depth + 1 and fnmatch("/".join(parts[:root_depth]) + "/", package_root):
            package = parts[root_depth]
            if package in PYTHON_NON_PACKAGE_FOLDERS:
                return None, ""
            return package, "/".join(parts[root_depth + 1 :])
    return None, ""


def check_python_file(root: Path, path: str, package: str, module_path: str) -> list[str]:
    try:
        tree = ast.parse(read_text(root, path), filename=path)
    except SyntaxError as error:
        return [f"{path}:{error.lineno}: can't be parsed, so its imports can't be checked: {error.msg}"]
    problems = []
    for line, module in python_imports(tree):
        reason = python_import_problem(module, package, module_path)
        if reason:
            problems.append(f"{path}:{line}: imports `{module}`: {reason}")
    return sorted(set(problems))


def python_imports(tree: ast.AST) -> list[tuple[int, str]]:
    """(line, module) for each import. `from torch import distributed` gives both torch and torch.distributed,
    so a rule on torch.distributed sees it. Relative imports stay inside their package and are skipped."""
    imports = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            imports += [(node.lineno, alias.name) for alias in node.names]
        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
            imports.append((node.lineno, node.module))
            imports += [(node.lineno, f"{node.module}.{alias.name}") for alias in node.names if alias.name != "*"]
    return imports


def python_import_problem(module: str, package: str, module_path: str) -> str | None:
    top_name = module.split(".")[0]
    if top_name in PYTHON_INTERNAL_DEPS:
        return python_internal_problem(top_name, package, module_path)
    if top_name in sys.stdlib_module_names:
        return python_forbidden_module_problem(top_name, module_path)
    return python_library_problem(module, package, module_path)


def python_forbidden_module_problem(top_name: str, module_path: str) -> str | None:
    forbidden_modules, reason = PYTHON_FORBIDDEN_MODULES.get(module_path, ([], ""))
    return reason if top_name in forbidden_modules else None


def python_internal_problem(imported: str, package: str, module_path: str) -> str | None:
    allowed = PYTHON_INTERNAL_DEPS[package] + PYTHON_FILE_EXTRA_DEPS.get(module_path, [])
    if imported == package or imported in allowed:
        return None
    return f"`{package}` may import only {', '.join(allowed) or 'no other package'} (contracts 2.2)"


def python_library_problem(module: str, package: str, module_path: str) -> str | None:
    library = longest_listed_prefix(module, PYTHON_LIBRARY_FILES)
    if library is None:
        return "not a §27 library (contracts 2.5); add it to the allowlist and its wrapper row first"
    rule = PYTHON_LIBRARY_FILES[library]
    if rule == NEVER:
        return f"`{library}` arrives only as a transitive package; no Rastai file imports it"
    if rule == TESTS_ONLY:
        return None if is_python_test(module_path) else f"`{library}` is for tests only"
    if any(fnmatch(module_path, pattern) for pattern in rule):
        return None
    if is_python_test(module_path) and any(fnmatch(f"{package}/{module_path}", pattern) for pattern in rule):
        # A package that may use a library throughout ("rastai_proto/*") may use it in its own tests too:
        # rastai_proto's tests start grpcio servers from the generated servicers. The tests folder sits beside
        # the import package, so its module path ("tests/test_services.py") doesn't carry the package name.
        return None
    return f"`{library}` is imported only in {', '.join(rule)} (contracts 2.5); call that wrapper instead"


def longest_listed_prefix(module: str, table: dict) -> str | None:
    """The longest key of table that is module or a dotted prefix of it: torch.distributed.rpc -> torch.distributed."""
    parts = module.split(".")
    for length in range(len(parts), 0, -1):
        prefix = ".".join(parts[:length])
        if prefix in table:
            return prefix
    return None


def is_python_test(module_path: str) -> bool:
    file_name = module_path.split("/")[-1]
    return module_path.startswith("tests/") or file_name.startswith("test_") or file_name == "conftest.py"


# ---- JavaScript ----


def check_javascript(root: Path) -> list[str]:
    problems = []
    for package_name, package_folder in find_js_packages(root):
        if package_name not in JS_INTERNAL_DEPS:
            problems.append(
                f"{package_folder}package.json: package `{package_name}` isn't in contracts 2.3 or check-imports' table"
            )
            continue
        source_folder = package_folder + JS_SOURCE_FOLDER
        problems.extend(symlink_problems(root, source_folder))
        for path in list_files(root / source_folder, JS_SUFFIXES):
            problems.extend(check_js_file(root, source_folder + path, package_name, package_folder))
    return problems


def symlink_problems(root: Path, source_folder: str) -> list[str]:
    """Every symlink under a scanned src/, and src/ itself if it is one. os.walk doesn't follow a symlinked folder,
    so this check would not read what it points to, while Vite follows it into the bundle. A symlink is refused
    rather than followed, so the scanned tree is the tree that gets bundled."""
    source = root / source_folder
    problems = []
    if source.is_symlink():
        problems.append(f"{source_folder.rstrip('/')}: is a symlink; src/ must hold real files only")
    for folder, child_folders, file_names in os.walk(source):
        for name in child_folders + file_names:
            entry = Path(folder) / name
            if entry.is_symlink():
                problems.append(f"{relative_path(root, entry)}: is a symlink; src/ must hold real files only")
    return problems


def find_js_packages(root: Path) -> list[tuple[str, str]]:
    """(name, folder ending in /) of every package.json in the workspace's package folders."""
    packages = []
    for pattern in JS_PACKAGE_FOLDER_PATTERNS:
        for manifest in sorted(root.glob(pattern + "package.json")):
            folder = manifest.parent.relative_to(root).as_posix() + "/"
            packages.append((json.loads(manifest.read_text()).get("name", ""), folder))
    return packages


def check_js_file(root: Path, path: str, package: str, package_folder: str) -> list[str]:
    text = read_text(root, path)
    # Read once here and handed on: the imports and the glob options both need the same spans and glob calls.
    spans = split_javascript(text)
    code = javascript_code_only(text)
    calls = glob_calls(text, code, spans)
    problems = []
    declares_types = path.endswith(TYPE_DECLARATION_SUFFIXES)
    for offset, specifier, is_type_only in js_imports(text, spans, calls):
        reason = js_import_problem(specifier, is_type_only or declares_types, path, package, package_folder)
        if reason:
            problems.append(f"{path}:{line_number_at(text, offset)}: imports `{specifier}`: {reason}")
    for offset, reason in glob_option_problems(text, code, calls):
        problems.append(f"{path}:{line_number_at(text, offset)}: imports `import.meta.glob`: {reason}")
    return problems


def js_imports(
    text: str, spans: list[tuple[str, int, int]], calls: list[tuple[int, int, int, list[int]]]
) -> list[tuple[int, str, bool]]:
    """(offset, specifier, is_type_only) for each import: strings right after `from` or `import` in code, the
    patterns of import.meta.glob, and JSDoc `import("...")` types in comments."""
    imports = []
    glob_patterns = {start for _, _, _, patterns in calls for start in patterns}
    # The code since the last string. A comment is whitespace in JavaScript, so it becomes one space here: the
    # code on both sides stays apart (`await/**/import(` must still read as `await import(`), and a comment
    # between `import(` and the specifier (`import(/* @vite-ignore */ "x")`) can't hide the `import(` before it.
    code_before = ""
    for kind, start, end in spans:
        if kind == "code":
            code_before += text[start:end]
        elif kind == "string":
            if start in glob_patterns or SPECIFIER_BEFORE.search(code_before):
                imports.append((start, text[start + 1 : end - 1], False))
            code_before = ""
        elif kind == "comment":
            code_before += " "
            imports += type_imports_in_comment(text[start:end], start)
    return imports


def glob_calls(text: str, code: str, spans: list[tuple[str, int, int]]) -> list[tuple[int, int, int, list[int]]]:
    """Each import.meta.glob call as (offset of its parenthesis, offset of the one that closes it, offset of the comma
    that starts its options, offsets of the string literals that are its patterns). The calls are found in code only,
    where `code` is the text with its comments and strings blanked, and `spans` is its split_javascript spans.
    The patterns are the strings of the first argument: the string itself, or each string of an array. Strings after
    that first comma are options (query: "?raw"), not paths."""
    string_starts = [start for kind, start, _ in spans if kind == "string"]
    calls = []
    for match in GLOB_CALL_START.finditer(code):
        open_at = match.end() - 1
        close_at = matching_close(code, open_at)
        options_start = end_of_first_argument(code, open_at, close_at)
        patterns = [start for start in string_starts if open_at < start < options_start]
        calls.append((open_at, close_at, options_start, patterns))
    return calls


def matching_close(code: str, open_at: int) -> int:
    """The offset of the bracket that closes the one at open_at, or the end of the code when none does."""
    depth = 0
    for position in range(open_at, len(code)):
        if code[position] in OPENING_BRACKETS:
            depth += 1
        elif code[position] in CLOSING_BRACKETS:
            depth -= 1
            if depth == 0:
                return position
    return len(code)


def end_of_first_argument(code: str, open_at: int, close_at: int) -> int:
    """The offset of the comma that ends the call's first argument, or the closing parenthesis when there is none.
    Commas inside an array or a nested call are at a deeper depth, so they don't end the argument."""
    depth = 0
    for position in range(open_at + 1, close_at):
        if code[position] in OPENING_BRACKETS:
            depth += 1
        elif code[position] in CLOSING_BRACKETS:
            depth -= 1
        elif code[position] == "," and depth == 0:
            return position
    return close_at


def glob_option_problems(text: str, code: str, calls: list[tuple[int, int, int, list[int]]]) -> list[tuple[int, str]]:
    """(offset of the call, reason) for each import.meta.glob call whose options can move its patterns outside src/.
    Only the options are read: a base in a string pattern (./base/*.jsx) or in the first argument is not an option."""
    problems = []
    for open_at, close_at, options_start, _ in calls:
        reason = glob_option_problem(text, code, options_start, close_at)
        if reason:
            problems.append((open_at, reason))
    return problems


def glob_option_problem(text: str, code: str, options_start: int, close_at: int) -> str | None:
    """Why one call's options are refused, or None. The backslash is looked for in the raw text, so an escape in a
    key is seen; `base` is looked for in code for an identifier and in the raw text for a quoted key."""
    if "\\" in text[options_start:close_at]:
        return GLOB_ESCAPE_REASON
    names_base = GLOB_BASE_IDENTIFIER.search(code, options_start, close_at) or GLOB_BASE_QUOTED_KEY.search(
        text, options_start, close_at
    )
    return GLOB_BASE_REASON if names_base else None


def type_imports_in_comment(comment: str, comment_start: int) -> list[tuple[int, str, bool]]:
    return [(comment_start + match.start(), match.group(1), True) for match in TYPE_IMPORT.finditer(comment)]


def js_import_problem(specifier: str, is_type_only: bool, path: str, package: str, package_folder: str) -> str | None:
    shape_problem = js_specifier_shape_problem(specifier)
    if shape_problem:
        return shape_problem
    if specifier.startswith(NEGATED_PATTERN_PREFIX):
        return NEGATED_PATTERN_REASON
    if specifier.startswith("."):
        return js_relative_problem(specifier, path, package_folder)
    if specifier.startswith(OUR_SCOPE):
        return js_internal_problem(specifier, is_type_only, path, package)
    if is_type_only:
        return None  # a type from a library the package may already use; erased at build time
    return js_library_problem(specifier, path)


def js_specifier_shape_problem(specifier: str) -> str | None:
    """A specifier that is refused whatever it names: a backslash, a node_modules segment or a root-absolute path."""
    if "\\" in specifier:
        return BACKSLASH_REASON
    if "node_modules" in specifier.split("/"):
        return NODE_MODULES_REASON
    if specifier.startswith("/"):
        return ROOT_ABSOLUTE_REASON
    return None


def js_relative_problem(specifier: str, path: str, package_folder: str) -> str | None:
    """A relative import from src/ must land in the same src/. Code outside src/ (a plugin's lib/ folder) is not
    scanned, so a src/ file that reaches it would move a locked import out of the scan."""
    target = posixpath.normpath(posixpath.join(posixpath.dirname(path), specifier))
    if (target + "/").startswith(package_folder + JS_SOURCE_FOLDER):
        return None
    if target == package_folder + JS_MANIFEST_FILE:
        return None
    return "reaches outside its package's src/; import the other package by name, and keep the code in src/"


def js_internal_problem(specifier: str, is_type_only: bool, path: str, package: str) -> str | None:
    imported = "/".join(specifier.split("/")[:2])
    if imported != specifier and specifier not in JS_SUBPATH_FOLDERS:
        return f"import `{imported}` itself; its files aren't public API"
    subpath_folders = JS_SUBPATH_FOLDERS.get(specifier)
    if subpath_folders and not path.startswith(tuple(subpath_folders)):
        return f"only {', '.join(subpath_folders)} may import it (frontend layout 2.10)"
    if specifier in JS_SUBPATH_TEST_FILES and not path.endswith(JS_TEST_SUFFIXES):
        return f"`{specifier}` is for test files only"
    allowed = js_allowed_internal_deps(path, package)
    if imported == package or imported in allowed:
        return None
    if is_type_only and imported in JS_TYPE_ONLY_DEPS.get(package, []):
        return None
    if imported in JS_TYPE_ONLY_DEPS.get(package, []):
        return f"`{package}` may name `{imported}` only in a JSDoc type import (contracts 2.4)"
    return f"`{package}` here may import only {', '.join(allowed) or 'no other package'} (contracts 2.3, 2.4)"


def js_allowed_internal_deps(path: str, package: str) -> list[str]:
    for folder, allowed in JS_FOLDER_DEPS.items():
        if path.startswith(folder):
            return allowed
    return JS_INTERNAL_DEPS[package]


def js_library_problem(specifier: str, path: str) -> str | None:
    library = js_library_name(specifier)
    rule = JS_LIBRARY_FILES.get(library)
    if rule is None:
        return "not a §27 library (contracts 2.5); add it to deps/allowlist-npm.json and its wrapper row first"
    if rule == TESTS_ONLY:
        return None if path.endswith(JS_TEST_SUFFIXES) else f"`{specifier}` is for tests only"
    if any(fnmatch(path, pattern) for pattern in rule):
        return None
    return f"`{library}` is imported only in {', '.join(rule)} (contracts 2.5)"


def js_library_name(specifier: str) -> str:
    """The npm package a specifier names: react-dom/client -> react-dom, @connectrpc/connect/x -> @connectrpc/connect.
    Every Node built-in (node:fs) is "node:"."""
    if specifier.startswith("node:"):
        return "node:"
    parts = specifier.split("/")
    return "/".join(parts[:2]) if specifier.startswith("@") else parts[0]


