def check_rust(root: Path) -> list[str]:
    problems = []
    for path in list_files(root, (".rs",)):
        code = rust_code_only(read_text(root, path))
        for match in RUST_PATH_ROOT.finditer(code):
            crate = match.group(1)
            allowed_files = RUST_LIBRARY_FILES.get(crate)
            if allowed_files and path not in allowed_files:
                line = line_number_at(code, match.start())
                problems.append(
                    f"{path}:{line}: uses `{crate}`, which only {', '.join(allowed_files)} may use (contracts 2.5)"
                )
    return sorted(set(problems))


