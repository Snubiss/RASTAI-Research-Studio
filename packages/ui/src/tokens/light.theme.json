{
  "$schema": "https://schemas.rastai.dev/rastai.theme/1.json",
  "type": "rastai.theme",
  "schema_version": 1,
  "id": "builtin_light",
  "name": "Light",
  "base": "light",
  "colors": {
    "background": "#f3f4f6",
    "surface": "#ffffff",
    "surface_raised": "#ffffff",
    "surface_sunken": "#eef0f3",
    "overlay": "#0b0d12",
    "text": "#16181d",
    "text_muted": "#59606e",
    "text_disabled": "#9aa0ab",
    "text_on_accent": "#ffffff",
    "border": "#d7dae1",
    "border_strong": "#737a88",
    "divider": "#e6e8ed",
    "accent": "#3a56d4",
    "accent_hover": "#2f47b8",
    "accent_active": "#263a99",
    "selection": "#e0e6ff",
    "focus_ring": "#3a56d4",
    "success": "#17784b",
    "series_1": "#0a66d8",
    "series_2": "#c75300",
    "series_3": "#1a7f37",
    "series_4": "#bf3989",
    "series_5": "#8250df",
    "series_6": "#9a6700",
    "series_7": "#0e7c86",
    "series_8": "#cf222e",
    "sequential_low": "#e7f0fb",
    "sequential_high": "#0b3d91",
    "diverging_negative": "#c75300",
    "diverging_zero": "#eef0f3",
    "diverging_positive": "#0a66d8",
    "canvas_background": "#f3f4f6",
    "canvas_grid": "#dfe2e8",
    "canvas_node": "#ffffff",
    "canvas_node_border": "#737a88",
    "canvas_node_selected": "#3a56d4",
    "canvas_edge": "#7b8290",
    "canvas_edge_active": "#3a56d4",
    "canvas_label": "#16181d",
    "canvas_port": "#59606e",
    "confidence_tint": "#c75300"
  },
  "typography": {
    "font_family_ui": "\"Geist\", \"Noto Sans\", system-ui, sans-serif",
    "font_family_mono": "\"Geist Mono\", \"DejaVu Sans Mono\", ui-monospace, monospace",
    "font_weights": {
      "regular": 400,
      "medium": 500,
      "bold": 600
    },
    "font_sizes_px": {
      "xs": 11,
      "sm": 12,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "xxl": 28
    },
    "line_heights": {
      "body": 1.5,
      "heading": 1.25,
      "code": 1.45
    }
  },
  "density": {
    "comfortable": {
      "spacing_px": [0, 4, 8, 12, 16, 24, 32, 48]
    },
    "compact": {
      "spacing_px": [0, 2, 4, 8, 12, 16, 24, 32]
    }
  },
  "radius_px": {
    "small": 4,
    "medium": 6,
    "large": 10
  },
  "motion": {
    "fast_ms": 120,
    "slow_ms": 240,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "focus_ring": {
    "width_px": 2,
    "offset_px": 2
  },
  "elevation": {
    "level_1": "0 1px 2px rgba(17, 20, 26, 0.08)",
    "level_2": "0 4px 12px rgba(17, 20, 26, 0.10), 0 1px 2px rgba(17, 20, 26, 0.06)",
    "level_3": "0 16px 40px rgba(17, 20, 26, 0.18), 0 2px 6px rgba(17, 20, 26, 0.08)"
  }
}
