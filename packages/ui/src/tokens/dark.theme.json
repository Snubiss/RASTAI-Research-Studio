{
  "$schema": "https://schemas.rastai.dev/rastai.theme/1.json",
  "type": "rastai.theme",
  "schema_version": 1,
  "id": "builtin_dark",
  "name": "Dark",
  "base": "dark",
  "colors": {
    "background": "#0d0f13",
    "surface": "#14171c",
    "surface_raised": "#1b1f26",
    "surface_sunken": "#090b0e",
    "overlay": "#000000",
    "text": "#e7e9ee",
    "text_muted": "#9ea5b2",
    "text_disabled": "#5b616c",
    "text_on_accent": "#0b0e1a",
    "border": "#282d36",
    "border_strong": "#6b7382",
    "divider": "#1f232a",
    "accent": "#8ea2ff",
    "accent_hover": "#a8b8ff",
    "accent_active": "#7189f2",
    "selection": "#232c52",
    "focus_ring": "#a8b8ff",
    "success": "#4bc386",
    "series_1": "#5aa2ff",
    "series_2": "#f0883e",
    "series_3": "#3fb950",
    "series_4": "#db61a2",
    "series_5": "#a371f7",
    "series_6": "#e3b341",
    "series_7": "#39c5cf",
    "series_8": "#ff7b72",
    "sequential_low": "#1b2a3f",
    "sequential_high": "#9ecbff",
    "diverging_negative": "#f0883e",
    "diverging_zero": "#262a32",
    "diverging_positive": "#5aa2ff",
    "canvas_background": "#0d0f13",
    "canvas_grid": "#1a1e25",
    "canvas_node": "#1b1f26",
    "canvas_node_border": "#6b7382",
    "canvas_node_selected": "#8ea2ff",
    "canvas_edge": "#5d6574",
    "canvas_edge_active": "#a8b8ff",
    "canvas_label": "#e7e9ee",
    "canvas_port": "#9ea5b2",
    "confidence_tint": "#f0883e"
  },
  "typography": {
    "font_family_ui": "\"Geist\", \"Noto Sans\", system-ui, sans-serif",
    "font_family_mono": "\"Geist Mono\", \"DejaVu Sans Mono\", ui-monospace, monospace",
    "font_weights": {
      "regular": 400,
      "medium": 500,
      "bold": 600
    },
    "font_sizes_px": {
      "xs": 11,
      "sm": 12,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "xxl": 28
    },
    "line_heights": {
      "body": 1.5,
      "heading": 1.25,
      "code": 1.45
    }
  },
  "density": {
    "comfortable": {
      "spacing_px": [0, 4, 8, 12, 16, 24, 32, 48]
    },
    "compact": {
      "spacing_px": [0, 2, 4, 8, 12, 16, 24, 32]
    }
  },
  "radius_px": {
    "small": 4,
    "medium": 6,
    "large": 10
  },
  "motion": {
    "fast_ms": 120,
    "slow_ms": 240,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "focus_ring": {
    "width_px": 2,
    "offset_px": 2
  },
  "elevation": {
    "level_1": "0 1px 2px rgba(0, 0, 0, 0.5)",
    "level_2": "0 4px 12px rgba(0, 0, 0, 0.45)",
    "level_3": "0 16px 40px rgba(0, 0, 0, 0.6)"
  }
}
